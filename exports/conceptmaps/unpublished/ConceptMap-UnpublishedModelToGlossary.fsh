      * display = "UsedDevice"
      * equivalence = #equivalent
  * element[+]
    * code = #BeModelDiagnosticReportDiabetes.Note
    * display = "Report comments in free text format. This element will not be provided by the producer of the report, but will be provided by the healthcare provider doing the interpretation."
    * target[+]
      * code = #Note
      * display = "Note"
      * equivalence = #equivalent
  * element[+]
    * code = #BeModelDiagnosticReportDiabetes.Patient
    * display = "We refer to the patient, subject of the report, by his unique identifier.This identifier is preferably the patient's national register number (NISS). In some cases, another unique identifier may be allowed."
    * target[+]
      * code = #Patient
      * display = "Patient"
      * equivalence = #equivalent
  * element[+]
    * code = #BeModelDiagnosticReportDiabetes.Performer
    * display = "We refer to the service provider or organization that collects the observations and produces the report. [2]The unique identifier of each natural person is the NISS, while for each organization the company number serves as the unique identifier.For the Diabetes Diagnostic Report, it is: “performer = recorder.»"
    * target[+]
      * code = #Performer
      * display = "Performer"
      * equivalence = #equivalent
